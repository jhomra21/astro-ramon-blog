---
import FormattedDate from './FormattedDate.astro';
import { getShortTitle, getSummary, type BlogEntry } from '@/lib/content';
import { REVEAL_STEP_MS, getRevealStyle, getStaggerStep } from '@/lib/reveal';

interface Props {
	entries: BlogEntry[];
	dateStyle?: 'year' | 'full';
	headingLevel?: 'h2' | 'h3';
	revealStartMs?: number;
}

const { entries, dateStyle = 'year', headingLevel: Heading = 'h2', revealStartMs = 0 } = Astro.props;
---

<ul class="flex flex-col gap-8">
	{entries.map((entry, index) => (
		<li
			class="reveal group relative flex flex-col gap-2"
			style={getRevealStyle(revealStartMs + REVEAL_STEP_MS * getStaggerStep(index))}
		>
			<div class="flex min-h-7 items-center gap-3">
				<Heading class="text-base font-medium text-neutral-950 decoration-neutral-400 underline-offset-4 group-hover:underline dark:text-neutral-50">
					<a href={`/blog/${entry.id}/`} class="outline-none after:absolute after:-inset-2 focus-visible:underline focus-visible:after:outline-2 focus-visible:after:outline-neutral-500">
						{getShortTitle(entry.data.title)}
					</a>
				</Heading>
				{entry.data.appStoreUrl && (
					<a
						href={entry.data.appStoreUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="button-flat relative z-10 h-7 px-2 text-xs before:absolute before:-inset-2"
						aria-label={`${getShortTitle(entry.data.title)} on the App Store`}
					>
						App Store
					</a>
				)}
				<span class="flex-1"></span>
				<span class="shrink-0 font-mono text-xs text-neutral-600 tabular-nums dark:text-neutral-400">
					{dateStyle === 'full' ? <FormattedDate date={entry.data.pubDate} /> : entry.data.pubDate.getFullYear()}
				</span>
			</div>
			<p class="text-pretty text-sm text-neutral-600 dark:text-neutral-400">{getSummary(entry.data.description)}</p>
		</li>
	))}
</ul>
