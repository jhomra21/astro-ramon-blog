---
interface Props {
	width?: 'default' | 'reading';
}

const { width = 'default' } = Astro.props;
---

<div class="mx-auto w-full max-w-[1120px] px-4 pt-8 pb-20 sm:pt-12">
	<div class:list={['flex flex-col gap-10', { 'max-w-3xl': width === 'default', 'max-w-2xl': width === 'reading' }]}>
		<slot />
	</div>
</div>
