---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import TransitionLayout from "./TransitionLayout.astro";
import PageColumn from "../components/PageColumn.astro";
import SlashLinks from "../components/SlashLinks.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { REVEAL_STEP_MS, getRevealStyle } from "../lib/reveal";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, githubUrl, npmUrl, appStoreUrl, projectUrl, techStack } = Astro.props;

const projectLinks = [
	...(appStoreUrl ? [{ label: "app store", href: appStoreUrl, isExternal: true }] : []),
	...(projectUrl ? [{ label: "live site", href: projectUrl, isExternal: true }] : []),
	...(githubUrl ? [{ label: "git repo", href: githubUrl, isExternal: true }] : []),
	...(npmUrl ? [{ label: "npm package", href: npmUrl, isExternal: true }] : []),
];
---

<TransitionLayout title={title} description={description}>
	<PageColumn width="reading">
		<article class="flex flex-col gap-10">
			<header class="reveal flex flex-col gap-4">
				<button id="back-button" type="button" class="link self-start cursor-pointer font-mono text-xs" aria-label="Go back to the previous page">
					← back
				</button>
				<h1 class="text-2xl font-medium tracking-tight text-balance text-neutral-950 dark:text-neutral-50">{title}</h1>
				<p class="flex flex-wrap gap-x-2 font-mono text-xs text-neutral-600">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span>
							· updated <FormattedDate date={updatedDate} />
						</span>
					)}
				</p>
				{projectLinks.length > 0 && <SlashLinks links={projectLinks} label="Project links" />}
			</header>

			{heroImage && (
				<Image
					src={heroImage}
					alt=""
					width={1344}
					height={672}
					class="reveal w-full h-auto border border-neutral-200 dark:border-neutral-800"
					style={getRevealStyle(REVEAL_STEP_MS)}
					quality="high"
					format="webp"
					loading="eager"
				/>
			)}

			<div class="reveal prose prose-neutral dark:prose-invert max-w-none" style={getRevealStyle(REVEAL_STEP_MS * 2)}>
				<slot />
			</div>

			{techStack && techStack.length > 0 && (
				<section class="flex flex-col gap-3 border-t border-neutral-200 pt-8 dark:border-neutral-800" aria-labelledby="stack-heading">
					<h2 id="stack-heading" class="font-mono text-xs text-neutral-600">stack</h2>
					<dl class="flex flex-col gap-2 text-sm">
						{techStack.map((tech) => (
							<div class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
								<dt class="shrink-0 font-medium sm:w-44">{tech.name}</dt>
								<dd class="text-neutral-600 dark:text-neutral-400">{tech.description}</dd>
							</div>
						))}
					</dl>
				</section>
			)}
		</article>
	</PageColumn>
</TransitionLayout>

<script>
	document.getElementById("back-button")?.addEventListener("click", () => {
		history.back();
	});
</script>

<style>
	@reference "../styles/global.css";

	.prose :global(:where(h2, h3, h4, h5, h6)) {
		@apply font-sans font-medium tracking-tight text-neutral-950 dark:text-neutral-50;
	}

	.prose :global(:where(h2, h3)) {
		text-wrap: balance;
	}

	.prose :global(:where(p, li)) {
		text-wrap: pretty;
	}

	/* Keep running text near 70 characters per line; images and code blocks still use the full column. */
	.prose :global(:where(h2, h3, p, ul, ol, blockquote)) {
		max-width: 35rem;
	}

	.prose > :global(:first-child) {
		margin-top: 0;
	}

	.prose :global(h2) {
		@apply mt-12 mb-3 text-xl;
	}

	.prose :global(h3) {
		@apply mt-8 mb-2 text-lg;
	}

	.prose :global(p) {
		@apply my-4 leading-relaxed text-neutral-700 dark:text-neutral-300;
	}

	.prose :global(ul) {
		@apply my-4 list-none space-y-2 pl-4;
	}

	.prose :global(li) {
		@apply relative text-neutral-700 dark:text-neutral-300;
	}

	.prose :global(li::before) {
		content: "—";
		@apply absolute -left-4 text-neutral-400;
	}

	.prose :global(a) {
		@apply font-normal text-neutral-950 underline decoration-neutral-400 underline-offset-4 transition-[text-decoration-color] duration-200 hover:decoration-current dark:text-neutral-50 dark:decoration-neutral-600;
	}

	.prose :global(code) {
		@apply rounded-sm bg-neutral-100 px-1 py-0.5 font-mono text-[0.85em] font-normal dark:bg-neutral-800;
	}

	.prose :global(code::before),
	.prose :global(code::after) {
		content: none;
	}

	.prose :global(pre) {
		@apply overflow-x-auto rounded-none border border-neutral-200 bg-neutral-50 p-4 text-xs leading-relaxed text-neutral-800 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200;
	}

	.prose :global(pre code) {
		@apply bg-transparent p-0 text-inherit;
	}

	.prose :global(blockquote) {
		@apply border-l-2 border-neutral-300 pl-4 font-normal not-italic text-neutral-600 dark:border-neutral-700 dark:text-neutral-400;
	}

	.prose :global(img) {
		@apply my-8 border border-neutral-200 dark:border-neutral-800;
	}
</style>
