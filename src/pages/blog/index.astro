---
import TransitionLayout from '../../layouts/TransitionLayout.astro';
import PageColumn from '@/components/PageColumn.astro';
import EntryList from '@/components/EntryList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getPosts } from '@/lib/content';
import { REVEAL_STEP_MS } from '@/lib/reveal';

const posts = await getPosts();
---

<TransitionLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<PageColumn>
		<div class="reveal flex flex-col gap-2">
			<h1 class="text-2xl font-medium tracking-tight">Blog</h1>
			<p class="text-sm text-neutral-600 dark:text-neutral-400">{posts.length} posts and project write-ups, newest first.</p>
		</div>
		<EntryList entries={posts} dateStyle="full" revealStartMs={REVEAL_STEP_MS} />
	</PageColumn>
</TransitionLayout>
