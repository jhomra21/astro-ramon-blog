---
import TransitionLayout from "../layouts/TransitionLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import ProjectsSection from "@/components/ProjectsSection.astro";
import HeroSection from "@/components/HeroSection.astro";
import QuickLinks from "@/components/QuickLinks.astro";
import { PROJECTS_REVEAL_START_MS } from "@/lib/reveal";
---

<TransitionLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="max-w-[1120px] mx-auto px-4 pt-6 pb-16 space-y-10">
		<HeroSection />

		<!-- Projects Section -->
		<div class="space-y-8">
			<ProjectsSection maxProjects={7} featuredOnly revealDelayMs={PROJECTS_REVEAL_START_MS} />
		</div>

		<!-- Quick Links -->
		<QuickLinks />
	</div>
</TransitionLayout>

